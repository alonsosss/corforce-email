PROJECT_NAME=core-force-mail
# development o test solo en local (make dev, make e2e): relajan controles
# (docs/Operacion_Despliegue.md, 1). Un servidor declara production o staging y el
# despliegue (ops/security/secrets/with-secrets.sh) se niega con cualquier otro valor.
ENVIRONMENT=development
TZ=America/Lima
# Perfil de despliegue del servidor (ops/maintenance/perfil-despliegue.sh): vacio o aws, la
# plataforma sobre servicios gestionados de AWS; selfhosted, servidor propio con Postgres, Redis,
# PgBouncer y proxy de borde en contenedores y TLS interno (docker-compose.selfhosted.yml,
# docs/Operacion_Despliegue.md 11). Un valor distinto detiene el despliegue.
DEPLOY_PROFILE=

# PostgreSQL - registro de plataforma (plano de control)
# Los servicios se conectan a "postgres" (alias de red de pgbouncer), nunca al
# Postgres real directamente.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# SECRETO del almacen (ops/security/secrets). En un servidor real, nunca un valor aqui: viene
# del almacen. El unico valor admitido en este fichero es el default de desarrollo del Postgres
# embebido (docker-compose.yml, perfil embedded-db); vacio usa ese mismo default.
POSTGRES_USER=mail_admin
POSTGRES_PASSWORD=dev_password_123
POSTGRES_DB=mail_registry

# Upstream real al que pgbouncer reenvia las conexiones.
#   - dev local: postgres-primary (contenedor; arranca con --profile embedded-db)
#   - produccion (AWS): endpoint de RDS, p.ej. <id>.<region>.rds.amazonaws.com
DB_UPSTREAM_HOST=postgres-primary
DB_UPSTREAM_PORT=5432
# Modo TLS de PgBouncer hacia la base. Vacio = verify-full, salvo con ENVIRONMENT=development o
# test, donde vale disable (el Postgres del compose no tiene certificado). Fuera de esos dos
# entornos el pooler no arranca con nada mas debil que verify-full.
DB_UPSTREAM_SSLMODE=

# Celda por defecto en la que nacen las empresas nuevas cuando el alta no indica otra.
# La celda se crea por API (POST /api/v1/cells) antes del primer tenant.
DEFAULT_CELL_CODE=pe-01

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
# SECRETO del almacen. Vacia en desarrollo (Redis sin autenticacion); en un servidor real,
# nunca un valor aqui.
REDIS_PASSWORD=
# TLS hacia el Redis de la plataforma (ElastiCache con cifrado en transito en AWS). Solo
# ENVIRONMENT=development|test admite false: en cualquier otro entorno los servicios que lo
# usan no arrancan en claro. La verificacion del certificado no se puede desactivar.
# REDIS_TLS_CA_FILE: PEM que se suma a las raices del sistema (CA interna de un Redis
# propio; ElastiCache no la necesita). REDIS_TLS_SERVER_NAME: nombre del certificado si no
# es REDIS_HOST.
REDIS_TLS=false
REDIS_TLS_CA_FILE=
REDIS_TLS_SERVER_NAME=

# Perfil selfhosted (docker-compose.selfhosted.yml). Con el, REDIS_TLS*, DB_UPSTREAM_* y
# POSTGRES_DIRECT_* de arriba los fija el perfil. INTERNAL_TLS_DIR: CA interna y certificados de
# postgres-primary y redis, fuera del repositorio (ops/security/internal-tls.sh).
INTERNAL_TLS_DIR=/opt/core-force-mail/tls
# Proxy de borde (selfhosted/edge). Sirve HTTPS del host de PUBLIC_BASE_URL (EDGE_PUBLIC_HOST solo
# si la web va en otro nombre) con el certificado de acme de deploy/mail (volumen MAIL_SSL_VOLUME,
# por defecto mail_ssl-vol; ADDITIONAL_SAN de acme debe incluir ese host). Con
# EDGE_REQUIRE_CLOUDFLARE=true solo admite conexiones desde los rangos de
# selfhosted/edge/cloudflare-ips.txt. EDGE_NETWORK_SUBNET: red entre el borde y el gateway, la
# unica de confianza para X-Real-IP; fuera del pool de redes de Docker del servidor.
# Opcionales con su valor por defecto: EDGE_BIND_ADDRESS=0.0.0.0, EDGE_HTTP_PORT=80,
# EDGE_HTTPS_PORT=443, EDGE_MAX_BODY_SIZE=101m, EDGE_BODY_TMPFS_SIZE=256m, EDGE_MEMORY_LIMIT=384m,
# EDGE_HSTS_MAX_AGE=31536000, EDGE_CERT_CHECK_INTERVAL=3600, EDGE_TLS_CERT_FILE y
# EDGE_TLS_KEY_FILE (cert.pem y key.pem de acme).
EDGE_PUBLIC_HOST=
EDGE_REQUIRE_CLOUDFLARE=true
EDGE_NETWORK_SUBNET=172.31.255.0/28
# Dominio propio de seguimiento de marketing (vacio: no se sirve). Va tambien en ADDITIONAL_SAN y en
# SES_TRACKING_DOMAIN de ops/aws/setup-ses.sh; EDGE_TRACKING_ORIGIN vacio = r.<SES_REGION>.awstrack.me.
EDGE_TRACKING_HOST=
EDGE_TRACKING_ORIGIN=
MAIL_SSL_VOLUME=mail_ssl-vol

# NATS
NATS_URL=nats://nats:4222

# Token de acceso firmado con Ed25519 (EdDSA con kid). El access token dura 5 minutos: al no
# haber revocacion en caliente del access token, su duracion ES la ventana en que un token
# robado sigue sirviendo; el cliente lo renueva en memoria.
# kid de la clave de firma vigente (lo imprime ops/security/jwt-keygen.sh); solo lo usa
# identity y debe figurar en JWT_PUBLIC_KEYS con la misma clave o identity no arranca.
JWT_SIGNING_KID=
# Claves publicas del token de acceso, kid:base64(SPKI DER) separadas por comas: la
# vigente y, durante una rotacion, la anterior. Obligatoria para el gateway; no es secreta.
JWT_PUBLIC_KEYS=
# SECRETO del almacen, solo para identity: clave privada PKCS#8 DER en base64. Vacia solo
# con ENVIRONMENT=development|test (par efimero con aviso). Para el compose local, generar
# un par con ops/security/jwt-keygen.sh y poner las tres variables en el .env local.
JWT_SIGNING_KEY=
# Vida del access token, de 2m a 5m (se puede acortar, nunca alargar: es la ventana en que un
# token robado sigue sirviendo), y de la cookie del refresh, de 1h a 8760h.
JWT_ACCESS_TTL=5m
JWT_REFRESH_TTL=168h

# Contrasenas filtradas (identity): al crear o cambiar una contrasena se consulta Have I
# Been Pwned con k-anonimato (solo viajan 5 caracteres del SHA-1). Encendido por defecto;
# "off" para entornos sin salida a internet. La URL admite un espejo propio.
PASSWORD_BREACH_CHECK=on
PASSWORD_BREACH_API_URL=https://api.pwnedpasswords.com/range/

# Emisor que muestran las aplicaciones de MFA: el de la plataforma (identity) y el de la verificacion
# en dos pasos de los buzones (webmail). De 1 a 64 caracteres, sin ':' (separa emisor y cuenta).
MFA_ISSUER=Core Force Mail

# Cookie de refresco: Secure siempre true salvo desarrollo local sin TLS.
AUTH_COOKIE_SECURE=true

# Object storage: Amazon S3 (protocolo S3, via pkg/objectstore). En AWS:
# MINIO_ENDPOINT=s3.<region>.amazonaws.com, MINIO_USE_SSL=true, MINIO_REGION=<region> y
# ACCESS/SECRET vacios para autenticar con el rol IAM del host. Para desarrollo, un
# servicio S3-compatible propio. Los binarios se separan por tenant con prefijo de clave
# (public/tenants/{id}/... y private/tenants/{id}/...) dentro de un unico bucket.
# Perfil autoalojado (DEPLOY_PROFILE=selfhosted): MinIO del propio servidor (docker-compose.selfhosted.yml,
# docs/Operacion_Despliegue.md, 11, "Almacen de objetos"). El perfil fija MINIO_ENDPOINT=minio:9000 al
# gateway; aqui solo MINIO_BUCKET (obligatoria: la crea minio-init). MINIO_ACCESS_KEY y MINIO_SECRET_KEY
# son SECRETOS: van en el almacen (ops/security/secrets/secret-keys.txt), nunca con valor en este fichero.
MINIO_ENDPOINT=
MINIO_BUCKET=
MINIO_REGION=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=

# Respaldos (ops/backup/README.md). Solo configuracion: la credencial del bucket y la frase de
# cifrado NO van aqui (el .env llega entero a cada contenedor), sino en BACKUP_SECRETS_FILE
# (ops/security/secrets/secret-keys-backup.txt).
BACKUP_DIR=
# Dias de retencion local de cada corrida (entero >= 1; por defecto 3).
BACKUP_KEEP_DAYS=
# Copia externa, OPCIONAL: bucket DISTINTO al de medios. Sin el, solo queda la copia local.
BACKUP_S3_BUCKET=
# Vacio = Amazon S3 con el rol de la instancia. Con valor = S3-compatible (Cloudflare R2:
# https://<cuenta>.r2.cloudflarestorage.com), que exige credencial propia y cifrado en reposo.
BACKUP_S3_ENDPOINT=
# Region de firma (R2: auto).
BACKUP_S3_REGION=
# Fichero de secretos del respaldo, 0600 del usuario que lo corre (por defecto
# /opt/core-force-mail/env/backup.env). Ningun contenedor lo recibe.
BACKUP_SECRETS_FILE=
# Respaldo de los volumenes de correo de deploy/mail: proyecto de compose de los motores y
# volumenes a respaldar (por defecto "crypt-vol vmail-vol": claves de mail_crypt y buzones).
MAIL_COMPOSE_PROJECT=
BACKUP_MAIL_VOLUMES=
# Volumenes de la plataforma que entran en la misma corrida, con el prefijo de COMPOSE_PROJECT_NAME
# (por defecto app). Vacia: "minio-data" en el perfil selfhosted y ninguno en el de aws.
BACKUP_PLATFORM_VOLUMES=

# Origen publico del API (lo usa la CSP para connect-src y las URLs publicas persistidas).
API_ORIGIN=https://api.YOUR_DOMAIN.com

# CORS: dominio(s) del frontend, separados por coma.
CORS_ALLOWED_ORIGINS=https://app.YOUR_DOMAIN.com

# API Gateway
GATEWAY_PORT=8080
# SECRETO del almacen. Vacia solo con ENVIRONMENT=development|test (RequireGatewayToken deja
# pasar sin comprobar); en un servidor real, nunca un valor aqui.
INTERNAL_GATEWAY_TOKEN=
# Redes desde las que se acepta X-Real-IP (proxy de borde). Vacio en desarrollo: docker-compose.yml
# no confia en ninguna (127.0.0.1/32) y docker-compose.selfhosted.yml usa la subred edge. Con un
# proxy delante en desarrollo, aqui su subred. El gateway sin compose, con esto vacio, confia en
# los rangos privados y loopback.
TRUSTED_PROXY_CIDRS=
# Control de acceso en el gateway: off | audit | enforce; fallo: open | closed.
RBAC_ENFORCE_MODE=enforce
RBAC_READ_MODE=enforce
RBAC_FAIL_MODE=closed
# Reconfirmar la identidad en las acciones que una sesion robada no debe poder hacer: off |
# enforce. En enforce, borrar a una persona, reiniciar su contrasena, cambiar la politica de
# sesion, emitir una clave de API y guardar la credencial de un proveedor DNS exigen la cabecera
# X-Step-Up, que se obtiene en POST /auth/step-up con la contrasena y, si la persona lo tiene, su
# segundo factor. La consola ya intercepta STEP_UP_REQUIRED y reintenta, asi que enforce es el
# valor correcto en un servidor real; off existe solo para un cliente que todavia no lo haga.
# Ojo: sin segundo factor, el step-up solo pide la contrasena. Para que estas acciones exijan de
# verdad dos factores, las personas con poder de administrar deben tener MFA.
STEP_UP_MODE=enforce
# Cupos por minuto e IP del gateway: el general de /api/v1, de 1 a 60000, y el estricto de
# autenticacion, de 1 a 600 y no mayor que el general (sus rutas gastan tambien el general).
API_RATE_LIMIT_PER_MIN=600
AUTH_RATE_LIMIT_PER_MIN=30
# Cupo por minuto e IP de los webhooks de proveedores ("limit": "webhook" en routes.json: los
# eventos de SES por SNS), de 60 a 600000, aparte del general.
WEBHOOK_RATE_LIMIT_PER_MIN=6000
# Tabla de rutas alternativa (JSON con el mismo contrato que services/gateway/routes.json).
GATEWAY_ROUTES_FILE=
# Direccion de cada servicio de la tabla: <SERVICIO>_HOST y <SERVICIO>_HOST_PORT (IDENTITY_HOST,
# IDENTITY_HOST_PORT...); vacias valen default_host y default_port de la tabla, los de compose.
# organization las lee para identity, access-control y mail-directory cuando falta su
# <SERVICIO>_URL. Se validan todas al arrancar, se usen o no: puerto de 1 a 65535 (tambien
# default_port) y host sin espacios ni delimitadores de URL (IPv6 sin corchetes).
# Instancias por celda de los servicios de celda: "celda=host:puerto,...". Las leen el gateway,
# domain-service (las de mail-security y mail-directory) y organization (la de mail-directory: la
# baja de una empresa la da de baja en su celda). Vacias y sin GATEWAY_BASE_CELL_CODE = una
# celda: todo va al destino base (<SERVICIO>_HOST en el gateway; MAIL_DIRECTORY_URL y
# MAIL_SECURITY_URL en domain-service; MAIL_DIRECTORY_URL en organization). El webmail de cada celda recibe su
# inicio de sesion por el dominio del buzon y el resto por la celda del token de su cookie.
MAIL_SECURITY_CELL_HOSTS=
MAIL_DIRECTORY_CELL_HOSTS=
WEBMAIL_CELL_HOSTS=
# Celda que sirven los destinos base (MAIL_SECURITY_HOST, MAIL_DIRECTORY_HOST y WEBMAIL_HOST; en
# domain-service, MAIL_SECURITY_URL y MAIL_DIRECTORY_URL). Obligatoria si alguna *_CELL_HOSTS
# declara instancias.
# Con ella el gateway y domain-service preguntan a organization la celda de cada empresa; una
# celda sin instancia recibe 503 en el gateway, y en domain-service su paso falla y se reintenta:
# fijarla en cuanto el registro tenga una segunda celda.
GATEWAY_BASE_CELL_CODE=

# Migraciones canonicas: organization barre las empresas existentes al arrancar
# (segundo plano, idempotente, serializado por advisory lock). false solo para desplegar
# sin tocar el esquema de las empresas. El runner conecta directo al Postgres real (sin
# pgbouncer) usando POSTGRES_DIRECT_HOST/PORT; sin ellos cae al host normal.
RUN_TENANT_MIGRATIONS=true
POSTGRES_DIRECT_HOST=
POSTGRES_DIRECT_PORT=
TENANT_MIGRATION_DIR=/app/migrations/tenant/canonical

# Correo transaccional de la propia plataforma (reinicio de contrasena, avisos) y URL
# publica con la que se construyen los enlaces que viajan en esos correos.
TRANSACTIONAL_MAIL_URL=http://transactional:8045
PUBLIC_BASE_URL=https://app.YOUR_DOMAIN.com

# Auditoria: subjects que se persisten en el rastro, separados por coma. Cada uno tiene su consumidor durable
# (audit-<subject>) sobre el stream de su dueno, que audit declara: el primer token da el nombre del stream en
# mayusculas (identity.> en IDENTITY; mail.> en MAIL_DIRECTORY). Un subject de un dominio con otro nombre de stream
# no arranca hasta que se declare (docs/adr/0006, seccion 7). Los mail.* son los hechos de seguridad de los buzones
# (docs/Plan_Webmail_Seguridad.md): van uno a uno sobre MAIL_DIRECTORY, cuyo mail.> ya los captura.
AUDIT_SUBJECTS=identity.>,organization.>,access.>,gateway.>,scheduler.>,domains.>,migration.>,webmail.assistant.used,mail.mailbox.mfa_enabled,mail.mailbox.mfa_disabled,mail.mailbox.forwarding_changed,mail.policy.updated
# Fuerza bruta que detecta audit: fallos de inicio de sesion desde una IP (1 a 10000) en la
# ventana, en minutos (1 a 1440).
SECURITY_BRUTEFORCE_MAX=5
SECURITY_BRUTEFORCE_WINDOW_MIN=15
# Cada cuanto audit registra y publica (audit.chain.anchored) la cabeza de sus cadenas de hash, de
# 1m a 24h: lo que tarda en notarse el borrado de las ultimas filas. La llave de la cadena
# (AUDIT_HASH_KEY, AUDIT_HASH_KEYS_OLD) viene del almacen de secretos y es opcional (docs/adr/0006).
AUDIT_ANCHOR_INTERVAL=15m
# Plazo de cada verificacion de la cadena de hash dentro de una peticion (GET /audit/integrity de una cadena
# pequena), de 1s a 28s (por debajo del WriteTimeout de 30 s); vencido, 504. Cada una lee la cadena entera de la
# empresa (un recorrido por empresa y 4 por proceso).
AUDIT_VERIFY_TIMEOUT=25s
# Verificacion de la cadena en segundo plano (POST /audit/integrity/runs; docs/adr/0006, seccion 6). Hasta que tamano
# de cadena (suma de las posiciones de cabeza de las dos, de 1000 a 50000000) contesta GET /audit/integrity dentro
# de la peticion; mas alla responde 202 y lanza una verificacion completa.
AUDIT_INTEGRITY_INLINE_MAX_ROWS=200000
# Plazo total de una verificacion en segundo plano, de 1m a 72h: vencido, queda fallida (timeout).
AUDIT_INTEGRITY_RUN_TIMEOUT=12h
# Cada cuanto el barrido periodico pasa de verificar solo lo nuevo a una verificacion completa, de 1h a 90d.
AUDIT_INTEGRITY_FULL_EVERY=168h
# Cada cuanto se verifica la cadena de cada empresa sin que nadie lo pida, de 1h a 7d. Vacio o 0 lo desactiva
# (por defecto): decide cada cuanto compensa leer las cadenas en una base compartida.
AUDIT_INTEGRITY_SWEEP_INTERVAL=
# Ancla externa (docs/adr/0006, seccion 8): direcciones de correo, separadas por coma y FUERA de la plataforma,
# que reciben el informe con la ultima ancla de cada cadena de cada empresa (solo identificadores, posiciones y
# hashes, firmado con AUDIT_HASH_KEY), cada AUDIT_ANCHOR_REPORT_INTERVAL (de 1h a 7d, alineado al reloj UTC) y de
# inmediato cuando una verificacion da una cadena por rota. Sale como correo de la plataforma (TRANSACTIONAL_URL,
# PLATFORM_TENANT_ID, PLATFORM_FROM_EMAIL), que con AUDIT_ANCHOR_RUA puesta pasan a ser obligatorias para audit.
# Vacia (por defecto), nada cambia: la cabeza anclada solo vive en este servidor. Se comprueba fuera con
# ops/security/verificar-ancla.sh.
AUDIT_ANCHOR_RUA=
AUDIT_ANCHOR_REPORT_INTERVAL=24h
# Alerta de extraccion masiva del gateway: lecturas de un usuario (1 a 100000) en la ventana,
# en minutos (1 a 60).
EXFIL_READ_THRESHOLD=400
EXFIL_WINDOW_MIN=5

# Scheduler: barrido por empresa en paralelo, de 1 a 64 empresas a la vez y de 1s a 30s (el
# intervalo del barrido) por empresa.
SCHEDULER_TENANT_CONCURRENCY=4
SCHEDULER_TENANT_TIMEOUT=20s
# Reintentos de una ejecucion fallida reintentable: espera base (1s a 1h, se duplica en cada
# intento) y techo (1s a 24h, no menor que la base). Catalogo de manejadores alternativo (vacio: el embebido, services/scheduler/handlers.json).
SCHEDULER_RETRY_BASE_DELAY=30s
SCHEDULER_RETRY_MAX_DELAY=1h
SCHEDULER_HANDLERS_FILE=

# Puertos de los servicios, de 1 a 65535 (internos, no cambiar salvo conflicto)
IDENTITY_PORT=8001
ACCESS_CONTROL_PORT=8002
ORGANIZATION_PORT=8003
AUDIT_PORT=8030
SCHEDULER_PORT=8033
MAIL_DIRECTORY_PORT=8040
MAIL_AUTH_PORT=8041
MAIL_SECURITY_PORT=8042
DOMAIN_SERVICE_PORT=8043
WEBMAIL_PORT=8044
TRANSACTIONAL_PORT=8045
SUPPRESSION_PORT=8046
TEMPLATES_PORT=8047
CONTACTS_PORT=8050
AUTOMATIONS_PORT=8051
CAMPAIGNS_PORT=8052
ANALYTICS_PORT=8053
REPUTATION_PORT=8054
BILLING_PORT=8055
OBSERVABILITY_PORT=8059

# Servicios de celda: base de la celda a la que pertenecen (directorio de correo). Con ella
# mail-security firma y el gateway enruta los enlaces publicos de cuarentena, mail-directory
# y mail-security rechazan (403 TENANT_NOT_IN_CELL) a toda empresa que organization no situe
# en esta celda, y el webmail la pone en cada token de sesion y solo acepta los de su celda.
# mail-directory y mail-security no arrancan sin CELL_CODE ni ORGANIZATION_URL; el webmail, sin
# un CELL_CODE con forma de codigo de celda.
CELL_CODE=pe-01
CELL_DB_NAME=mail_cell_pe_01
# Credencial de la base de la celda (el secreto CELL_DB_PASSWORD vive en el almacen, nunca
# aqui). Vacio = <CELL_DB_NAME>_svc, el rol que crea ops/db/cell-service-role.sh.
CELL_DB_USER=
# Solo desarrollo (ENVIRONMENT=development) y sin rol de celda: contrasena de plataforma
# para los servicios de celda. En produccion, siempre vacia.
CELL_SERVICES_PLATFORM_PASSWORD=

# Servicios del plano de EMPRESA (audit, scheduler, domain-service, transactional,
# suppression, templates, contacts, reputation, campaigns, automations, analytics). Cada uno
# resuelve en que base vive cada empresa con el rol de enrutado (solo SELECT sobre
# organization.v_tenant_routing) y abre esa base con su rol propio, que solo alcanza su
# esquema. Los dos los crea ops/db/tenant-service-role.sh y sus contrasenas
# (TENANT_ROUTER_DB_PASSWORD y <SERVICIO>_DB_PASSWORD) viven en el almacen, nunca aqui.
# Vacio = mail_router, el rol que crea --router.
REGISTRY_DB_USER=
# Solo desarrollo y mientras un servicio no tenga su rol: contrasena de plataforma para los
# servicios de empresa. En produccion, siempre vacia; sin ella y sin rol propio el servicio
# arranca con la de plataforma y lo avisa en el registro.
TENANT_SERVICES_PLATFORM_PASSWORD=
# URLs internas entre servicios (red de compose): http(s)://host[:puerto], sin ruta, usuario,
# consulta ni fragmento. Mal formada, el servicio que la lee no arranca (config.ServiceURL).
ACCESS_CONTROL_URL=http://access-control:8002
IDENTITY_URL=http://identity:8001
# La celda de cada empresa (GET /internal/organization/tenants/{id}/cell): la consultan
# mail-directory y mail-security para rechazar a las empresas de otras celdas, y domain-service,
# con GATEWAY_BASE_CELL_CODE, para llamar a la instancia de la celda de cada empresa.
# domain-service la necesita siempre: reclama cada dominio en el indice global de organization
# antes de activarlo y lo suelta al retirarlo.
ORGANIZATION_URL=http://organization:8003
# Saga de alta y baja de empresas (organization): cuanto puede tardar una ejecucion antes
# de que otra instancia la de por abandonada, de 2m (los tres intentos de la baja en la celda)
# a 1h, y cada cuanto se retoman las que quedaron sin dueno, de 1s a 1h.
ORGANIZATION_SAGA_LEASE=5m
ORGANIZATION_SAGA_SWEEP_INTERVAL=1m
MAIL_DIRECTORY_URL=http://mail-directory:8040
MAIL_SECURITY_URL=http://mail-security:8042
# El webmail lleva a mail-dav (API JSON interna) la libreta personal y el calendario del buzon.
MAIL_DAV_URL=http://mail-dav:8058
# Y a mail-files los ficheros grandes que el buzon comparte por enlace. Vacia, el webmail arranca sin la funcion.
MAIL_FILES_URL=http://mail-files:8061
SUPPRESSION_URL=http://suppression:8046
TEMPLATES_URL=http://templates:8047
CONTACTS_URL=http://contacts:8050
BILLING_URL=http://billing:8055
REPUTATION_URL=http://reputation:8054
TRANSACTIONAL_URL=http://transactional:8045
# analytics cierra en el scheduler la ejecucion de la poda que este le despacha.
SCHEDULER_URL=http://scheduler:8033

# Via de marketing de transactional: carril propio (cola, trabajadores y tasa) para que
# una campana nunca retrase un codigo de acceso o una factura. Trabajadores: de 1 a 64. Tasa:
# de 1 a 10000 envios por segundo, sin superar la cuota de la cuenta de SES.
SES_MAX_SEND_RATE_MARKETING=10
# Fraccion de la cuota diaria de SES (de 0.05 a 0.9) que el marketing no puede consumir: cuando lo
# enviado en 24 h por toda la cuenta llega a la cuota menos esta reserva, los mensajes de marketing se
# aplazan 10 minutos y el transaccional sigue saliendo. La decide el vigilante de la cuenta
# (SES_ACCOUNT_MONITOR_INTERVAL); con el vigilante apagado no se frena.
SES_MARKETING_QUOTA_RESERVE=0.2
TRANSACTIONAL_MARKETING_WORKERS=4
# Los enlaces del HTML de marketing llevan utm_source, utm_medium=email y utm_campaign (objeto utm
# del lote). Nunca los del host de PUBLIC_BASE_URL (baja, ver en el navegador) ni los de estos
# dominios, separados por comas y con sus subdominios. Vacio: solo se excluye la plataforma.
MARKETING_UTM_EXCLUDED_DOMAINS=

# Enlace de ver en el navegador ({{.view_in_browser_url}}), firmado con MAIL_LINK_SIGNING_KEY:
# vigencia desde el envio (24h a 17520h; por defecto 2160h, 90 dias). Envios de prueba de
# plantilla por empresa y hora (1 a 1000): una prueba no se factura y este es su tope.
VIEW_IN_BROWSER_TTL=2160h
TRANSACTIONAL_TEST_SENDS_PER_HOUR=50

# Campanas: tamano del lote que se pide a contacts y se entrega a transactional (1 a 500, el
# tope del lote de transactional) y cada cuanto el orquestador avanza las campanas en envio
# (1s a 10m).
CAMPAIGNS_BATCH_SIZE=500
CAMPAIGNS_TICK=15s

# Automatizaciones: cada cuanto el ejecutor avanza los pasos debidos (1s a 10m); tope de
# correos del doble opt-in por contacto (anti abuso: una empresa no puede escribir una y otra
# vez a quien se dio de baja), por dia (1 a 100) y por 30 dias (1 a 1000); y ejecuciones de
# un flujo bloqueadas por reputacion o plan en una hora que lo pausan (1 a 100000).
AUTOMATIONS_TICK=15s
AUTOMATIONS_DOI_MAX_PER_DAY=1
AUTOMATIONS_DOI_MAX_PER_30D=3
AUTOMATIONS_PAUSE_AFTER_FAILURES=20
# Automatizaciones: cada cuanto se recorren, como mucho, los aniversarios de cada flujo por
# fecha (10s a 6h). Un aniversario se detecta con este retraso como maximo tras su hora local.
AUTOMATIONS_DATE_SCAN_INTERVAL=10m

# Analitica: dias de detalle por mensaje que se conservan antes de podar, de 1 a 3650 (los
# agregados diarios no se podan).
ANALYTICS_MESSAGE_RETENTION_DAYS=90

# Reputacion de envio (reputation). Umbrales como fraccion decimal sobre la ventana movil;
# por debajo de REPUTATION_MIN_VOLUME envios no se juzga. Los valores de bloqueo quedan
# por debajo de los que usa SES para revisar una cuenta (5 % rebotes, 0,1 % quejas): la
# plataforma frena a una empresa antes de que SES frene a todas. Todas obligatorias: la
# ventana, de 24h a 8760h en dias completos; los umbrales, mayores que 0 y menores que 1, el
# aviso por debajo del bloqueo; el volumen minimo y los limites, de 1 a 1000000000, el de la
# hora no mayor que el del dia.
REPUTATION_WINDOW=168h
REPUTATION_MIN_VOLUME=200
REPUTATION_BOUNCE_WARN=0.02
REPUTATION_BOUNCE_BLOCK=0.04
REPUTATION_COMPLAINT_WARN=0.0005
REPUTATION_COMPLAINT_BLOCK=0.0008
REPUTATION_DEFAULT_HOURLY_TRANSACTIONAL=2000
REPUTATION_DEFAULT_DAILY_TRANSACTIONAL=20000
REPUTATION_DEFAULT_HOURLY_MARKETING=5000
REPUTATION_DEFAULT_DAILY_MARKETING=50000

# Plan que recibe una empresa nueva al darse de alta. Sin valor, la empresa nace sin
# suscripcion y billing lo registra: nunca se inventa un plan en codigo.
BILLING_DEFAULT_PLAN_CODE=
# Dias de prueba de la suscripcion por defecto (0 a 366).
BILLING_TRIAL_DAYS=0
# Interruptor de puesta en marcha: con false, una empresa sin suscripcion conserva sus
# derechos mientras se asignan planes a las existentes. En produccion, true.
BILLING_ENFORCE=false
# Cada cuanto se cierran los periodos vencidos (1m a 24h).
BILLING_PERIOD_SWEEP_INTERVAL=15m
# Rastro de deduplicacion de eventos de consumo (168h, lo que un stream reentrega, a 8760h).
BILLING_PROCESSED_EVENTS_RETENTION=720h

# Contactos: vigencia del enlace de doble opt-in (1h a 720h) y filas por importacion
# (maximo 200000).
CONTACTS_DOI_TTL=72h
CONTACTS_IMPORT_MAX_ROWS=50000
# Contactos: hora UTC desde medianoche del barrido completo diario contra suppression (0 a
# 24h), la red de seguridad por si se pierde un evento de suppression.
CONTACTS_FULL_SWEEP_AT=4h
# Contactos: dias que se conserva la interaccion (aperturas y clics por envio) desde su ultimo
# hito, de 365 (el tope de las reglas de los ultimos N dias) a 3650.
CONTACTS_ENGAGEMENT_RETENTION_DAYS=400
# Formularios de suscripcion publicos (docs/Operacion_Despliegue.md, «Captacion»): tiempo minimo
# entre servir el formulario y enviarlo (1s a 1m), vigencia del token con que se sirve (10m a
# 24h), envios por IP en la ventana (1 a 1000; IPv6 por /64) y envios por formulario y hora
# (1 a 100000). Los cupos van en el Redis de la plataforma, comunes a todas las replicas.
CONTACTS_FORM_MIN_FILL=3s
CONTACTS_FORM_TOKEN_TTL=2h
CONTACTS_FORM_SUBMITS_PER_IP=10
CONTACTS_FORM_IP_WINDOW=10m
CONTACTS_FORM_SUBMITS_PER_FORM_HOUR=300
# Suppression: cada cuanto anuncia (suppression.entry.expired) las exclusiones manuales que
# caducaron (1s a 1h).
SUPPRESSION_EXPIRY_SWEEP_INTERVAL=1m

# Amazon SES (transaccional y marketing). Las claves (SES_ACCESS_KEY_ID, SES_SECRET_ACCESS_KEY)
# son las del usuario core-force-mail-ses de ops/aws/setup-iam.sh y viven en el almacen de
# secretos; sin ellas se usa la cadena del host, que solo existe en EC2 (rol IAM). Los valores
# de abajo los imprime ops/aws/verificar-ses.sh. Configuration sets separados por clase de envio. Los eventos de SES llegan
# por SNS al gateway en /api/v1/public/transactional/ses-events (una suscripcion para toda
# la plataforma: la empresa sale de la etiqueta firmada) y las dos rutas de eventos EXIGEN el ARN del topic;
# sin el se rechazan. /ses-events/{tenant_id} solo admite ese mismo topic (una firma valida de SNS prueba que
# firmo AWS, no de que cuenta viene).
SES_EVENTS_TOPIC_ARN=
SES_REGION=us-east-1
SES_CONFIG_SET_TRANSACTIONAL=cfm-transactional
SES_CONFIG_SET_MARKETING=cfm-marketing
# Cada cuanto lee transactional el estado de la cuenta de SES (cuota, pausa, reputacion) para
# las alertas del grupo salida-ses, de 1m a 1h; 0 lo apaga (un entorno sin SES).
SES_ACCOUNT_MONITOR_INTERVAL=5m
# Identidades de SES de los dominios de las empresas: domain-service da de alta en SES cada dominio
# de envio (purpose sending o both) al verificarse, con su misma clave DKIM (BYODKIM), MAIL FROM
# bounce.<dominio> y SES_CONFIG_SET_TRANSACTIONAL como conjunto por defecto, y pide el MX y el SPF de
# ese MAIL FROM en la region SES_REGION. Sus claves (SES_IDENTITIES_ACCESS_KEY_ID,
# SES_IDENTITIES_SECRET_ACCESS_KEY) son las del usuario core-force-mail-ses-identidades de
# ops/aws/setup-iam.sh y viven en el almacen de secretos, solo para domain-service. Sin ellas la
# integracion queda desactivada (aviso en el log) y el servicio arranca igual; con una sola no arranca.
# Tasa del carril transaccional, de 1 a 10000 envios por segundo, sin superar la cuota de la
# cuenta de SES.
SES_MAX_SEND_RATE=10
# Trabajadores del carril transaccional, de 1 a 64.
TRANSACTIONAL_WORKERS=4
# Remitente de los correos de la propia plataforma (reinicio de contrasena, avisos): debe
# ser un dominio verificado de la empresa de plataforma.
PLATFORM_FROM_EMAIL=no-reply@YOUR_DOMAIN.com
# id (uuid) de la empresa de plataforma (slug `platform`): identity envia con ella el correo del sistema, porque su
# dominio de remitente solo esta verificado alli y transactional lo busca entre los de la empresa que envia. Sin
# ella el correo sale como la empresa de cada usuario y falla con 422 (SENDING_DOMAIN_NOT_VERIFIED) en cuanto no
# es la de plataforma. Se obtiene con `SELECT id FROM organization.tenants WHERE slug = 'platform'` en el registro.
# transactional la usa ademas para contar aparte lo que entra por el relay con la clave global del otro producto
# (transactional_relay_messages_total{account="plataforma"}), que es el umbral de docs/Plan_Integracion_ERP.md, 8.
PLATFORM_TENANT_ID=
PLATFORM_FROM_NAME=Core Force Mail
# Solo para el arranque de una plataforma nueva, antes de verificar el dominio del
# remitente de plataforma. En produccion: false.
PLATFORM_FROM_ALLOW_UNVERIFIED=false

# Dominios de las empresas: lo que deben publicar en DNS para verificar. Sin valor por
# defecto en codigo; domain-service no arranca sin ellos.
MAIL_MX_HOSTNAME=mail.YOUR_DOMAIN.com
MAIL_SPF_INCLUDE=include:spf.YOUR_DOMAIN.com
# Los informes DMARC de todas las empresas llegan a esta direccion: debe ser un buzon real, en un dominio
# de la plataforma que reciba correo (MX propio, dado de alta por el superadmin) y con el TXT de
# autorizacion *._report._dmarc.<ese dominio> = "v=DMARC1"; sin ese TXT los receptores no envian nada a un
# dominio distinto del de la empresa. Ver docs/Operacion_Despliegue.md, "Informes DMARC".
MAIL_DMARC_RUA=reportes@dmarc.YOUR_DOMAIN.com
# Opcional. Los informes TLS-RPT (RFC 8460) de todas las empresas llegan a esta direccion: una sola, y un
# buzon real de la plataforma. Vacia, domain-service no pide el registro _smtp._tls a los dominios y
# TLS-RPT no se publica. Ver docs/adr/0003-mta-sts-y-tls-rpt-entrantes.md.
MAIL_TLSRPT_RUA=
# Resolver (host:puerto) con el que domain-service comprueba los registros DNS de los dominios de las
# empresas. Vacio usa el del sistema; el perfil autoalojado usa 1.1.1.1:53 por defecto, porque el del
# proveedor cachea las respuestas negativas y un dominio recien publicado tardaba horas en verificar.
MAIL_DNS_RESOLVER=
# API de Cloudflare a la que domain-service lleva el token de cada empresa que publica su DNS en
# automatico. Vacia es https://api.cloudflare.com; solo se cambia en pruebas (un Cloudflare falso),
# con la regla de URLs internas (sin ruta) y, fuera de development y test, solo por https.
CLOUDFLARE_API_URL=
# Barrido de dominios: cada cuanto reverifica, de 5m a 6h; empresas a la vez, de 1 a 64, y
# tiempo por empresa, de 1m al intervalo. El techo de 6h es el de la alerta
# BarridoDeDominiosSinCelda, que cuenta con un barrido cada 6h como mucho: alargarlo exige
# alargar su ventana y su espera (ops/observability/prometheus/rules/plataforma.yml) y el
# techo de services/domain-service/main.go.
DOMAIN_RECHECK_INTERVAL=6h
DOMAIN_SWEEP_CONCURRENCY=4
DOMAIN_SWEEP_TENANT_TIMEOUT=5m
# Historial de comprobaciones DNS, de 168h (la ventana en que se reverifica un dominio
# pendiente) a 8760h.
DOMAIN_CHECK_RETENTION=720h
# Gracia de la clave DKIM anterior en una rotacion programada, contada desde la ultima vez que
# pudo firmar, de 144h a 720h. El suelo es maximal_queue_lifetime de Postfix (5d,
# deploy/mail/postfix/conf/main.cf.base) mas un dia de TTL de un TXT: el correo firmado con ella puede
# seguir en cola hasta entonces. Alargar la cola exige subir el suelo (make checks lo comprueba).
# Una clave comprometida no espera a la gracia: se revoca (POST /api/v1/domains/{id}/revoke-dkim).
MAIL_DKIM_ROTATION_GRACE=168h
# mail-security: cada cuanto repasa las claves DKIM del Redis de los motores y retira las de
# dominios que la celda no sirve o cuya empresa ya no existe (cerrojo de lider), de 1s a 15m. El
# techo es el intervalo con que cuentan las alertas RepasoDKIMDetenido y RepasoDKIMSinOrganization:
# alargarlo exige alargar su umbral, su ventana y sus esperas
# (ops/observability/prometheus/rules/plataforma.yml) y el techo de services/mail-security/main.go.
MAIL_DKIM_RECONCILE_INTERVAL=15m

# Autenticacion de los motores (mail-auth): TLS que Dovecot y el webmail consumen en 9082 (el
# par se relee al cambiar en disco; vacio = autofirmado en memoria, que el webmail no verifica; en
# DEPLOY_PROFILE=selfhosted lo fija el perfil con la CA interna) y freno de
# fuerza bruta en Redis: fallos por buzon e IP (1 a 1000) y por IP (1 a 10000) en la ventana
# (1m a 24h) y duracion del bloqueo (1m a 24h).
MAIL_AUTH_TLS_PORT=9082
MAIL_AUTH_TLS_CERT=
MAIL_AUTH_TLS_KEY=
MAIL_AUTH_MAX_FAILURES=10
MAIL_AUTH_MAX_FAILURES_PER_IP=50
MAIL_AUTH_FAILURE_WINDOW=15m
MAIL_AUTH_LOCK_TTL=30m
# Credenciales de destino por trabajo de migracion (docs/adr/0002): mail-auth se las pregunta a mail-migration
# (MAIL_MIGRATION_URL, con el token interno) y solo las acepta desde la red del ejecutor
# (MAIL_AUTH_JOB_ALLOWED_NETS, lista de CIDR: ${MAIL_MIGRATION_IPV4_NETWORK}.0/24). Van juntas y vacias por
# defecto: sin ellas esas credenciales se deniegan y el ejecutor conserva el maestro compartido de Dovecot.
MAIL_MIGRATION_URL=
MAIL_AUTH_JOB_ALLOWED_NETS=

# Webmail (servicio de celda): IMAP con el Dovecot y submission del Postfix de la celda,
# credencial verificada en MAIL_AUTH_URL y sesion propia en Redis (cookie cf_wm, Secure
# segun AUTH_COOKIE_SECURE). El TLS con los motores se verifica contra MAIL_HOSTNAME
# (WEBMAIL_TLS_SERVER_NAME lo cambia); WEBMAIL_TLS_CA_FILE anade una CA propia, la que
# firme MAIL_AUTH_TLS_CERT. WEBMAIL_TLS_INSECURE_SKIP_VERIFY=true y WEBMAIL_IMAP_TLS=none
# solo con ENVIRONMENT=development|test: con cualquier otro (staging y sin declarar
# incluidos) el servicio no arranca con ellos.
# Secretos, solo en el almacen: WEBMAIL_MASTER_USER (= DOVECOT_MASTER_USER@platform.local),
# WEBMAIL_MASTER_PASSWORD (= DOVECOT_MASTER_PASS, 32 caracteres o mas) y WEBMAIL_IMAGE_PROXY_KEY
# (32 caracteres o mas, igual en todas las celdas; en development o test, sin ella se sortea una
# por proceso).
WEBMAIL_IMAP_ADDR=dovecot:993
WEBMAIL_IMAP_TLS=implicit
WEBMAIL_SMTP_ADDR=postfix:587
WEBMAIL_SMTP_TLS=starttls
WEBMAIL_TLS_SERVER_NAME=
WEBMAIL_TLS_CA_FILE=
WEBMAIL_TLS_INSECURE_SKIP_VERIFY=false
# Sesion: inactividad (1m a 24h) y vida maxima (1m a 720h, no menor que la inactividad).
# Destinatarios por mensaje, de 1 a 1000 (smtpd_recipient_limit de Postfix), y topes en
# bytes, hasta 104857600 (message_size_limit de deploy/mail/postfix/conf/main.cf.base, que es
# tambien lo que clamd analiza entero: StreamMaxLength y MaxFileSize de
# deploy/mail/clamav/clamd.conf). Un adjunto mayor no tendria veredicto de ClamAV y el
# envio se cortaria con 503 SCAN_UNAVAILABLE; ops/scaffold/check-mail-size-limits.sh ata
# los tres ficheros.
WEBMAIL_SESSION_IDLE=30m
WEBMAIL_SESSION_MAX=12h
# Cupo de peticiones por buzon y minuto (60 a 100000) en todo lo que se sirve con sesion, comun a
# todas las replicas (Redis): una oficina tras una sola IP no comparte cupo. Lo que no tiene sesion
# (inicio de sesion, segundo paso de la verificacion en dos pasos, citas publicas) cuenta por IP.
WEBMAIL_RATE_LIMIT_PER_MAILBOX=600
# Proxy de imagenes remotas: con "mostrar imagenes" el mensaje apunta a enlaces firmados del
# webmail y el navegador del lector nunca habla con el servidor del remitente. El enlace vale
# WEBMAIL_IMAGE_PROXY_TTL (5m a 24h); cada descarga, WEBMAIL_IMAGE_PROXY_TIMEOUT de principio a fin
# (1s a 1m) y WEBMAIL_IMAGE_PROXY_MAX_BYTES (65536 a 26214400); a la vez, como mucho
# WEBMAIL_IMAGE_PROXY_CONCURRENCY (1 a 64) por replica, de ellas WEBMAIL_IMAGE_PROXY_CONCURRENCY_PER_MAILBOX
# (1 a la anterior) de un mismo buzon; y WEBMAIL_IMAGE_PROXY_RATE_PER_MAILBOX (30 a
# 10000) descargas por buzon y minuto, cupo propio comun a las replicas (Redis).
WEBMAIL_IMAGE_PROXY_TTL=1h
WEBMAIL_IMAGE_PROXY_TIMEOUT=10s
WEBMAIL_IMAGE_PROXY_MAX_BYTES=5242880
WEBMAIL_IMAGE_PROXY_CONCURRENCY=8
WEBMAIL_IMAGE_PROXY_CONCURRENCY_PER_MAILBOX=2
WEBMAIL_IMAGE_PROXY_RATE_PER_MAILBOX=300
# Avisos en tiempo real del webmail (SSE con IMAP IDLE). Cada buzon vigilado mantiene una sesion IMAP en IDLE
# (un proceso imap de Dovecot, unos 5 a 10 MB) compartida por sus pestanas: el tope de buzones acota la
# memoria de la celda. 0 desactiva los avisos y la interfaz refresca por sondeo.
WEBMAIL_EVENTS_MAX_PER_MAILBOX=5
WEBMAIL_EVENTS_MAX_MAILBOXES=100
WEBMAIL_MAX_RECIPIENTS=100
WEBMAIL_MAX_MESSAGE_BYTES=26214400
WEBMAIL_MAX_BODY_PART_BYTES=2097152
WEBMAIL_MAX_ATTACHMENT_BYTES=52428800
# ClamAV de la celda: analiza cada adjunto antes de enviarlo o guardarlo. Sin el, el
# servicio no arranca salvo WEBMAIL_ALLOW_UNSCANNED_ATTACHMENTS=true, que solo vale con
# ENVIRONMENT=development|test.
WEBMAIL_CLAMD_ADDR=clamd:3310
WEBMAIL_ALLOW_UNSCANNED_ATTACHMENTS=false
# Envio programado: el mensaje espera en la carpeta Scheduled del buzon y mail-directory guarda la
# fila. Cada replica del webmail reclama las vencidas cada WEBMAIL_SCHEDULED_POLL_INTERVAL (1s a 5m;
# es el retraso maximo sobre la hora pedida) de WEBMAIL_SCHEDULED_BATCH en WEBMAIL_SCHEDULED_BATCH
# (1 a 20, en paralelo; cada envio en curso ocupa hasta unas cuatro veces WEBMAIL_MAX_MESSAGE_BYTES
# de memoria). WEBMAIL_SCHEDULED_MAX_DAYS (1 a 365, por debajo de los 366 que admite mail-directory)
# es lo mas lejos que se puede programar.
WEBMAIL_SCHEDULED_POLL_INTERVAL=15s
WEBMAIL_SCHEDULED_BATCH=4
# Envios y borradores del webmail que se componen a la vez (1-32). Cada uno puede ocupar unas
# cinco veces WEBMAIL_MAX_MESSAGE_BYTES en memoria; el resto recibe 503 COMPOSE_BUSY con
# Retry-After, y cada buzon compone de uno en uno. Dimensionar junto al lote programado.
WEBMAIL_COMPOSE_CONCURRENCY=2
WEBMAIL_SCHEDULED_MAX_DAYS=365
# Recordatorios (posponer un mensaje y seguimiento de uno enviado): mail-directory guarda la fila y
# cada replica reclama las vencidas cada WEBMAIL_REMINDERS_POLL_INTERVAL (1s a 5m; retraso maximo
# sobre la hora pedida) de WEBMAIL_REMINDERS_BATCH en WEBMAIL_REMINDERS_BATCH (1 a 20, en paralelo,
# una conexion IMAP cada uno). WEBMAIL_REMINDERS_MAX_DAYS (1 a 365) es lo mas lejos que se puede
# posponer o fijar un seguimiento.
WEBMAIL_REMINDERS_POLL_INTERVAL=30s
WEBMAIL_REMINDERS_BATCH=4
WEBMAIL_REMINDERS_MAX_DAYS=365
# Fichero vCard que se importa a la libreta personal, en bytes (1 a 52428800); se lee entero en
# memoria antes de pasarlo a mail-dav, que aplica ademas sus propios topes.
WEBMAIL_MAX_IMPORT_BYTES=5242880
# Asistente del webmail (docs/adr/0015): resume, propone respuestas, cambia el tono y extrae citas con
# la API de Claude. La clave ANTHROPIC_API_KEY va SOLO en el almacen de secretos y es opcional: sin ella
# el asistente no se ofrece. Ademas cada empresa lo activa desde el panel. WEBMAIL_ASSISTANT_API_URL
# debe ser https fuera de development y test. WEBMAIL_ASSISTANT_MODEL sirve resumen y extraccion y
# WEBMAIL_ASSISTANT_DRAFT_MODEL (por defecto el mismo) la redaccion; MAX_OUTPUT_TOKENS (64 a 8192) acota
# el coste de cada peticion. Topes servidos a la interfaz: caracteres enviados por peticion (1000 a
# 200000), mensajes por resumen de hilo (1 a 50), caracteres de las indicaciones (1 a 2000) y
# peticiones por buzon y por empresa al dia (1 a 100000; la empresa no por debajo del buzon).
# SETTINGS_TTL (1s a 10m) es lo que tarda en notarse que una empresa lo apago.
WEBMAIL_ASSISTANT_API_URL=https://api.anthropic.com
WEBMAIL_ASSISTANT_MODEL=claude-haiku-4-5
WEBMAIL_ASSISTANT_DRAFT_MODEL=
WEBMAIL_ASSISTANT_MAX_OUTPUT_TOKENS=1024
WEBMAIL_ASSISTANT_TIMEOUT=30s
WEBMAIL_ASSISTANT_MAX_ATTEMPTS=3
WEBMAIL_ASSISTANT_MAX_INPUT_CHARS=24000
WEBMAIL_ASSISTANT_MAX_THREAD_MESSAGES=20
WEBMAIL_ASSISTANT_MAX_INSTRUCTION_CHARS=500
WEBMAIL_ASSISTANT_MAILBOX_DAILY_LIMIT=50
WEBMAIL_ASSISTANT_TENANT_DAILY_LIMIT=500
WEBMAIL_ASSISTANT_SETTINGS_TTL=30s

# Politicas para los motores (mail-security): redes desde las que Rspamd y Postfix
# consultan, reinyeccion de cuarentena y tope de lineas de log en Redis. Puertos de 1 a 65535,
# hosts sin espacios ni delimitadores de URL, cuerpo de /pipe de 1 a 101 MiB (message_size_limit
# de Postfix mas 1 MiB, ops/scaffold/check-mail-size-limits.sh), lineas de RL_LOG de 1 a 10000 y
# reconciliacion de Redis de 1m a 1h. Los tres puertos de mail-security, distintos entre si.
# RSPAMD_CONTROLLER_URL sigue la regla de las URLs internas (config.ServiceURL).
MAIL_ENGINE_ALLOWED_CIDRS=
MAIL_POLICY_MAPS_PORT=8081
MAIL_POLICY_EXPORT_PORT=9081
MAIL_REDIS_PORT=6379
MAIL_QUARANTINE_MAX_BODY_MB=50
RSPAMD_CONTROLLER_URL=http://rspamd:11334
MAIL_QUARANTINE_REINJECT_HOST=postfix
MAIL_QUARANTINE_REINJECT_PORT=590
MAIL_LOG_LINES=9999
MAIL_REDIS_RECONCILE_INTERVAL=10m
# RSPAMD_CONTROLLER_PASSWORD (lectura del controller: la pantalla Antispam) y
# RSPAMD_CONTROLLER_ENABLE_PASSWORD (escritura: el aprendizaje desde la cuarentena) son secretos: viven en
# el almacen (ops/security/secrets/secret-keys.txt), no aqui.
# Aviso de cuarentena al buzon: mail-security barre cada MAIL_QUARANTINE_NOTIFY_INTERVAL
# las empresas con el aviso activo y lo envia por transactional (TRANSACTIONAL_URL con
# INTERNAL_GATEWAY_TOKEN). Los enlaces de liberar y descartar se firman con
# MAIL_LINK_SIGNING_KEY, cuelgan de PUBLIC_BASE_URL y caducan a MAIL_QUARANTINE_LINK_TTL.
# Barrido de 1m a 24h (el menor max_age_days de una empresa) y enlaces de 1h a 720h.
MAIL_QUARANTINE_NOTIFY_INTERVAL=15m
MAIL_QUARANTINE_LINK_TTL=72h
# Revocacion en Dovecot (deploy/mail/README.md): mail-security retira la credencial de un buzon por
# el API HTTP de doveadm de la celda, siempre por TLS verificado contra DOVEADM_API_TLS_SERVER_NAME
# (vacio = MAIL_HOSTNAME); DOVEADM_API_TLS_CA_FILE anade una CA propia. DOVEADM_API_KEY, la misma
# que recibe Dovecot, viene del almacen de secretos: sin ella mail-security solo arranca con
# ENVIRONMENT=development|test. DOVEADM_API_URL: https://host[:puerto], sin ruta, usuario,
# consulta ni fragmento.
DOVEADM_API_URL=https://dovecot:8443
DOVEADM_API_TLS_SERVER_NAME=
DOVEADM_API_TLS_CA_FILE=
# Gestor de la cola de Postfix (deploy/mail/README.md): mail-security habla con el agente que corre en el
# contenedor de Postfix, siempre por TLS verificado contra QUEUE_AGENT_TLS_SERVER_NAME (vacio =
# MAIL_HOSTNAME). QUEUE_AGENT_API_KEY, la misma que recibe Postfix, viene del almacen de secretos y es
# opcional: sin ella el gestor queda desactivado. Solo el superadmin lo usa.
QUEUE_AGENT_URL=https://postfix:8590
QUEUE_AGENT_TLS_SERVER_NAME=
QUEUE_AGENT_TLS_CA_FILE=
# Cada cuanto vigila mail-security la cola de Postfix para sus metricas y alertas (10s a 5m).
MAIL_QUEUE_POLL_INTERVAL=1m

# Motores de correo (deploy/mail/docker-compose.mail.yml). El directorio de correo vive en
# la base de la celda y los motores lo leen con el rol de solo lectura de SU celda,
# <MAIL_DB_NAME>_engine, que crea ops/db/cell-engine-role.sh: miembro del grupo mail_engine
# (de ahi saca sus permisos) y con CONNECT solo a la base de su celda. mail_engine, el rol
# de login compartido por todas las celdas de un cluster, se retira con
# `cell-engine-role.sh --retire-shared` cuando ninguna celda lo usa ya.
# MAIL_DB_PASSWORD vive en el almacen de secretos, nunca aqui.
MAIL_HOSTNAME=mail.YOUR_DOMAIN.com
MAIL_DB_HOST=postgres
MAIL_DB_PORT=5432
MAIL_DB_NAME=mail_cell_pe_01
MAIL_DB_USER=mail_cell_pe_01_engine
# SECRETO del almacen (secret-keys-db.txt). En un servidor real, nunca un valor aqui.
MAIL_DB_PASSWORD=
MAIL_REDIS_HOST=redis-mail
# SECRETO del almacen. Opcional: sin ella el Redis de los motores va sin autenticacion.
MAIL_REDIS_PASSWORD=
# TLS de mail-security hacia redis-mail: opcional, apagado y nunca exigido. Los motores lo
# leen en claro dentro de la red de la celda (deploy/mail/README.md, Contrato Redis);
# encenderlo exige que redis-mail abra ademas un tls-port. Mismo contrato que REDIS_TLS*.
MAIL_REDIS_TLS=false
MAIL_REDIS_TLS_CA_FILE=
MAIL_REDIS_TLS_SERVER_NAME=
MAIL_AUTH_URL=https://mail-auth:9082
# Redes desde las que vale el usuario maestro de Dovecot que usa el webmail (lista de CIDR;
# vacio = la red de los motores). DOVECOT_MASTER_USER y DOVECOT_MASTER_PASS vienen del
# almacen de secretos.
# El webmail entra con ese maestro: WEBMAIL_MASTER_USER debe ser <DOVECOT_MASTER_USER>@platform.local
# y WEBMAIL_MASTER_PASSWORD, la misma DOVECOT_MASTER_PASS; con otra forma no arranca.
DOVECOT_MASTER_ALLOWED_NETS=
# Nombre de la red docker de los motores (deploy/mail); los servicios mail-auth y
# mail-security se unen a ella con sus alias, y el webmail sin alias.
MAIL_ENGINES_NETWORK=mail-engines

# Cifrado de credenciales de terceros guardadas por empresa (AES-256-GCM, 64 hex).
# SECRETO del almacen, obligatoria (sin excepcion de entorno: domain-service, mail-migration,
# mail-directory, que cifra con ella el secreto de la verificacion en dos pasos de cada buzon, e
# identity, que cifra el del segundo factor de cada cuenta de la consola, no arrancan sin ella).
# Para desarrollo local, generar la propia con `openssl rand -hex 32` y ponerla en tu `.env` (no
# versionado); en un servidor real, nunca un valor aqui. MAIL_ENCRYPTION_KEYS_OLD: llaves retiradas
# (64 hex separadas por coma) durante una rotacion; los cuatro servicios que la reciben re-cifran lo
# suyo al arrancar y cada hora (docs/Operacion_Despliegue.md, seccion 2, rotacion de MAIL_ENCRYPTION_KEY).
MAIL_ENCRYPTION_KEY=
MAIL_ENCRYPTION_KEYS_OLD=
# Firma HMAC de enlaces de baja y seguimiento. SECRETO del almacen, obligatoria (sin excepcion de
# entorno: transactional no arranca sin ella). Desarrollo local: `openssl rand -base64 32` en tu
# `.env`; en un servidor real, nunca un valor aqui.
MAIL_LINK_SIGNING_KEY=
# Firma de los tokens de los formularios publicos de suscripcion (contacts; al menos 32 caracteres,
# openssl rand -hex 32). En un servidor real vive en el almacen de secretos.
CONTACTS_FORM_TOKEN_KEY=

# Observabilidad
# SECRETO del almacen. En un servidor real, nunca un valor aqui.
GRAFANA_ADMIN_PASSWORD=
# Entrega de las alertas por correo (docs/arquitectura/OBSERVABILIDAD.md, Entrega de las alertas). El
# remitente es un buzon de la propia plataforma con SMTP permitido; su clave es un secreto. Con la
# plataforma caida el aviso tampoco sale, asi que ALERT_EMAIL_TO debe ser una direccion EXTERNA.
ALERT_EMAIL_TO=operadores@YOUR_DOMAIN.com
ALERT_SMTP_HOST=mail.YOUR_DOMAIN.com:587
ALERT_SMTP_USER=alertas@YOUR_DOMAIN.com
# Fichero (0644, dentro de un directorio 0700) con la clave de ese buzon: Alertmanager la lee de disco.
ALERT_SMTP_PASS_FILE=/opt/core-force-mail/env/alert-smtp.pass
METRICS_TEXTFILE_DIR=/opt/core-force-mail/metrics

# Migracion de buzones desde otro proveedor (docs/adr/0002). mail-migration guarda los trabajos en la base de
# cada empresa y sirve dos listeners: la API de administracion (MAIL_MIGRATION_PORT, detras del gateway) y la
# del ejecutor mail-migration-runner (MAIL_MIGRATION_RUNNER_PORT, con MAIL_MIGRATION_RUNNER_KEY del almacen,
# solo en la red docker mail-migration). Sin esa clave el servicio arranca, no abre el listener del ejecutor y
# la API responde 503 NOT_CONFIGURED al crear. La contrasena de origen se cifra con MAIL_ENCRYPTION_KEY.
MAIL_MIGRATION_PORT=8056
MAIL_MIGRATION_RUNNER_PORT=8057
# Limite de trabajos pendientes o en curso por empresa (pendiente: pasarlo a un derecho del plan en billing).
MAIL_MIGRATION_MAX_ACTIVE_PER_TENANT=2
# Topes contra el uso de la migracion como sondeo o fuerza bruta (el ejecutor sale a Internet con la IP de la
# plataforma): trabajos que una empresa puede crear en 24 horas, trabajos contra el mismo servidor y usuario de
# origen que pueden terminar con las credenciales rechazadas en una hora, y trabajos reclamados a la vez entre
# todos los ejecutores de una instancia (cada ejecutor hace uno).
MAIL_MIGRATION_MAX_JOBS_PER_DAY=200
MAIL_MIGRATION_MAX_AUTH_FAILURES_PER_HOUR=5
MAIL_MIGRATION_MAX_RUNNING_JOBS=4
# Cuanto puede pasar un ejecutor sin latido antes de perder el trabajo, y cuantas veces se reintenta uno
# perdido antes de darlo por fallido.
MAIL_MIGRATION_LEASE=90s
MAIL_MIGRATION_MAX_ATTEMPTS=3
# Cada cuanto un reclamo sin trabajo conocido recorre las bases de todas las empresas activas.
MAIL_MIGRATION_SWEEP_INTERVAL=30s
# Cada trabajo reclamado trae su credencial de destino (abre solo el buzon del trabajo, desde la red del ejecutor,
# mientras esta en curso) en lugar de que el ejecutor use el maestro compartido de Dovecot. Exige antes
# MAIL_MIGRATION_URL y MAIL_AUTH_JOB_ALLOWED_NETS en mail-auth (arriba) y los motores desplegados; con true y el maestro
# ya retirado del almacen (DOVECOT_MIGRATION_MASTER_*) se cierra el riesgo del maestro. Orden en deploy/mail/README.md.
MAIL_MIGRATION_JOB_CREDENTIALS=false
# Conciliacion de buzones borrados: cada cuanto (0 la desactiva), edad minima del trabajo mas antiguo de un buzon para
# considerarlo (10m a 30d) y cuantos buzones retira como mucho por empresa y pasada. Retira lo que el consumidor de
# mail.mailbox.deleted no vio (buzones borrados antes de existir o mas alla de la retencion del stream).
MAIL_MIGRATION_RECONCILE_INTERVAL=6h
MAIL_MIGRATION_RECONCILE_GRACE=24h
MAIL_MIGRATION_RECONCILE_MAX_PURGES_PER_TENANT=100
# Puertos IMAP de origen admitidos (lista; el ejecutor la lee de aqui como MIGRATION_SOURCE_PORTS y no conecta
# a otros) y si se admite un origen sin TLS (false: TLS obligatorio).
MAIL_MIGRATION_SOURCE_PORTS=143,993
MAIL_MIGRATION_ALLOW_PLAINTEXT=false
# Solo pruebas: admite un servidor de origen en direcciones internas (SSRF). El servicio se niega a arrancar
# con true fuera de ENVIRONMENT=development|test.
MAIL_MIGRATION_ALLOW_PRIVATE_SOURCES=false
# Red docker compartida por Dovecot, mail-migration y el ejecutor; la crea deploy/mail/docker-compose.mail.yml.
MAIL_MIGRATION_NETWORK=mail-migration

# Editor visual de correos (templates, docs/Plan_Editor_Correos.md).
# ClamAV que analiza cada imagen subida antes de guardarla, por la red interna mail-scan (solo clamd y
# templates; la crea deploy/mail/docker-compose.mail.yml, subred MAIL_SCAN_IPV4_NETWORK.0/24, por defecto
# 172.22.3). Vacia, templates arranca y las subidas responden 503 SCANNER_UNAVAILABLE. Las imagenes van al
# almacen de MINIO_* (sin MINIO_ENDPOINT, 503 STORAGE_UNAVAILABLE) y su URL es
# PUBLIC_BASE_URL/media/public/<empresa>/templates/<sha256>.<ext>, que sirve el gateway.
TEMPLATES_CLAMD_ADDR=clamd:3310
MAIL_SCAN_NETWORK=mail-scan
# mail-security de la celda base: puntua con Rspamd el correo de prueba de la verificacion de
# entregabilidad (remitente PLATFORM_FROM_EMAIL, tiempo maximo 10 s, resultado reutilizado 10 min por
# contenido). Vacia o sin PLATFORM_FROM_EMAIL, la verificacion sale sin puntuacion (spam.available=false).
SPAM_CHECK_URL=http://mail-security:8042

# CardDAV y CalDAV (docs/adr/0004): contactos y calendario personales de cada buzon, sincronizables con iOS, Thunderbird y DAVx5.
# mail-dav guarda los datos en la base de cada empresa (esquema mail_dav) y autentica cada peticion con HTTP Basic
# contra mail-auth (MAIL_AUTH_URL, service "dav": exige dav_access y admite la contrasena de aplicacion). Basic solo
# es admisible porque el proxy de borde termina TLS. MAIL_DAV_DB_PASSWORD, solo en el almacen. Su prefijo publico
# (MAIL_DAV_BASE_PATH) es el que declara services/gateway/routes.json (self_authenticated "dav"); el gateway
# redirige /.well-known/carddav y /.well-known/caldav a el.
MAIL_DAV_PORT=8058
MAIL_DAV_BASE_PATH=/api/v1/dav
# Nombre de la libreta y del calendario que se crean solos la primera vez que un buzon descubre los suyos, y realm
# de Basic.
MAIL_DAV_DEFAULT_ADDRESSBOOK_NAME=Contactos
MAIL_DAV_DEFAULT_CALENDAR_NAME=Calendario
MAIL_DAV_REALM=Contactos
# Limites por buzon: bytes de un vCard (1024 a 4194304, el limite de la fila), propiedades de un vCard,
# contactos y libretas, cambios que se conservan por libreta para resolver un token de sincronizacion, y bytes de
# un cuerpo XML (PROPFIND, REPORT, MKCOL). Pendiente: pasarlos a derechos del plan en billing.
MAIL_DAV_MAX_VCARD_BYTES=262144
MAIL_DAV_MAX_VCARD_PROPERTIES=500
MAIL_DAV_MAX_CONTACTS_PER_MAILBOX=10000
MAIL_DAV_MAX_ADDRESSBOOKS_PER_MAILBOX=10
MAIL_DAV_CHANGES_RETAINED=5000
MAIL_DAV_MAX_REQUEST_BYTES=262144
# Limites de CalDAV por buzon: bytes de un evento (1024 a 4194304, el limite de la fila), lineas (propiedades y
# componentes) de un evento, eventos y calendarios. Las recurrencias no se expanden al guardar ni al servir: solo se
# expanden, con presupuesto, para decidir un calendar-query por rango. MAX_RECURRENCE_WORK es el trabajo (periodos
# recorridos y apariciones generadas) permitido a un evento y MAX_QUERY_RECURRENCE_WORK a una consulta entera; al
# agotarse, el evento se devuelve (nunca se omite) y el cliente lo expande.
MAIL_DAV_MAX_EVENT_BYTES=262144
MAIL_DAV_MAX_EVENT_PROPERTIES=1000
MAIL_DAV_MAX_EVENTS_PER_MAILBOX=20000
MAIL_DAV_MAX_CALENDARS_PER_MAILBOX=10
MAIL_DAV_MAX_RECURRENCE_WORK=20000
MAIL_DAV_MAX_QUERY_RECURRENCE_WORK=500000
# Espacio: bytes de objetos (vCard, y por separado iCalendar) que guarda un buzon (1 MiB a 4 GiB) y bytes de objetos que
# lleva como maximo una respuesta (64 KiB a 256 MiB; pasado el tope, 507 number-of-matches-within-limits). Un vCard o
# un evento de tamano maximo debe caber en los dos. Un listado que no pide address-data ni calendar-data no lee los
# objetos.
MAIL_DAV_MAX_MAILBOX_BYTES=67108864
MAIL_DAV_MAX_RESPONSE_BYTES=16777216
# Conciliacion de buzones borrados (la misma de mail-migration, docs/adr/0004): necesita MAIL_DIRECTORY_URL. 0 desactiva.
MAIL_DAV_RECONCILE_INTERVAL=6h
MAIL_DAV_RECONCILE_GRACE=24h
MAIL_DAV_RECONCILE_MAX_PURGES_PER_TENANT=100
# Peticiones por minuto e IP real (el freno de fuerza bruta por buzon e IP lo aplica mail-auth).
MAIL_DAV_RATE_LIMIT_PER_MIN=1200
# Peticiones que se atienden a la vez (pasado el tope, 503 con Retry-After) y plazo de cada una (1s a 120s: al vencer
# se cancelan sus consultas). El pool de la base de cada empresa es de diez conexiones.
MAIL_DAV_MAX_INFLIGHT=64
MAIL_DAV_REQUEST_TIMEOUT=25s
# Verificacion de credenciales: cada verificacion en mail-auth es un bcrypt. Un acierto se recuerda MAIL_DAV_AUTH_CACHE_TTL
# (0s lo apaga, hasta 1m; nunca se recuerda un rechazo): es lo que tarda en aplicarse el cambio de una contrasena, de
# dav_access o la baja de un buzon. MAIL_DAV_AUTH_MAX_CONCURRENT acota las verificaciones simultaneas contra mail-auth, que
# tambien atiende a Dovecot.
MAIL_DAV_AUTH_CACHE_TTL=10s
MAIL_DAV_AUTH_MAX_CONCURRENT=16
# TLS con mail-auth: MAIL_DAV_TLS_CA_FILE anade una CA propia (la que firma MAIL_AUTH_TLS_CERT);
# MAIL_DAV_TLS_INSECURE_SKIP_VERIFY=true solo con ENVIRONMENT=development|test (viaja la contrasena del buzon).
MAIL_DAV_TLS_CA_FILE=
MAIL_DAV_TLS_INSECURE_SKIP_VERIFY=false
# API interna del webmail (/internal/mail-dav, contactos y calendario en JSON; los topes los sirve /internal/mail-dav/meta):
# tamano y tarjetas de un .vcf importado, ventana maxima y apariciones de una consulta del calendario, y paginas del listado
# de contactos. El cupo es MAIL_DAV_RATE_LIMIT_PER_MIN por buzon (no por IP) y comparte MAIL_DAV_MAX_INFLIGHT con DAV.
MAIL_DAV_MAX_IMPORT_BYTES=4194304
MAIL_DAV_MAX_IMPORT_CARDS=1000
MAIL_DAV_MAX_EVENT_WINDOW_DAYS=62
MAIL_DAV_MAX_OCCURRENCES=5000
MAIL_DAV_CONTACTS_PAGE_SIZE=50
MAIL_DAV_MAX_CONTACTS_PAGE_SIZE=100
# Planificacion (disponibilidad del equipo, invitaciones y pagina de citas; docs/adr/0004). La ocupacion de cada evento
# se materializa al guardarlo desde MAIL_DAV_BUSY_LOOKBACK_DAYS atras hasta MAIL_DAV_BUSY_HORIZON_DAYS adelante (como
# mucho MAIL_DAV_MAX_BUSY_PER_EVENT tramos); una consulta de disponibilidad completa hasta MAIL_DAV_BUSY_REFRESH_MAX
# eventos pendientes. MAIL_DAV_BUSY_HORIZON_DAYS=0 apaga la planificacion (las rutas responden 503).
MAIL_DAV_BUSY_HORIZON_DAYS=400
MAIL_DAV_BUSY_LOOKBACK_DAYS=7
MAIL_DAV_MAX_BUSY_PER_EVENT=1000
MAIL_DAV_BUSY_REFRESH_MAX=500
MAIL_DAV_AVAILABILITY_MAX_ADDRESSES=20
# Pagina publica de citas: techo del tope diario de reservas que elige cada dueno, reservas por visitante y dia,
# huecos de una respuesta y ventana maxima de una consulta (hasta 62 dias).
MAIL_DAV_BOOKING_MAX_DAILY=50
MAIL_DAV_BOOKING_MAX_PER_VISITOR=2
MAIL_DAV_BOOKING_MAX_SLOTS=300
MAIL_DAV_BOOKING_MAX_WINDOW_DAYS=31
# Con varias celdas: mail-auth de las demas ("celda=https://host:puerto", separadas por comas). MAIL_AUTH_URL es el
# de la celda GATEWAY_BASE_CELL_CODE y la celda de cada buzon sale del indice de dominios de organization
# (ORGANIZATION_URL). Vacia, todo va a MAIL_AUTH_URL.
MAIL_AUTH_CELL_URLS=
# URL con la que un cliente CardDAV o CalDAV llega a mail-dav por el gateway (mail-directory la ofrece a la web en los datos
# de conexion del buzon): https, con el prefijo MAIL_DAV_BASE_PATH. Vacia, la web no ofrece datos de conexion.
MAIL_DAV_PUBLIC_URL=https://app.YOUR_DOMAIN.com/api/v1/dav/
# Retencion de una direccion de buzon recien borrada (mail-directory): mientras su marca de baja sea mas joven que esto y
# el barrido de maildir de Dovecot (maildir_reconcile.sh, cada 5 min) no la haya consumido, crear un buzon con ese nombre
# responde 409 ADDRESS_RECENTLY_DELETED: asi el buzon nuevo nunca nace con el correo del anterior. Mayor que
# MAILDIR_RECONCILE_GRACE mas la cadencia del barrido; 0 desactiva la retencion.
MAIL_DIRECTORY_MAILBOX_RECREATE_HOLD=15m

# Visor de registros del superadmin (services/observability, docs/adr/0009): consulta Loki, la pila de
# docker-compose.observability.yml, por la red compartida. LOKI_URL sigue la regla de las URLs internas
# (config.ServiceURL); vacia, el servicio arranca igual y el visor responde 503 NOT_CONFIGURED. El perfil
# autoalojado la fija a http://loki:3100. Loki nunca publica puerto: solo se alcanza desde dentro.
LOKI_URL=

# Claves de API y relay SMTP de envio (docs/adr/0013-claves-de-api-y-relay-smtp.md, oleada 3-G).
# La llave del hash de las claves (API_KEY_HASH_KEY, API_KEY_HASH_KEYS_OLD) es un secreto del almacen, no va aqui.
# Gateway: cupo por clave de API (peticiones por minuto, de 1 a 60000) y vida de la cache de claves resueltas
# (de 1s a 5m; una revocacion llega antes por la marca en Redis). La misma cache la usa smtp-relay.
API_KEY_RATE_LIMIT_PER_MIN=600
API_KEY_CACHE_TTL=30s
# Direccion publica del relay que la pagina de claves ensena a las empresas (access-control). Vacia: la
# plataforma no ofrece SMTP y la pagina no lo muestra.
SMTP_RELAY_PUBLIC_HOST=
SMTP_RELAY_PUBLIC_STARTTLS_PORT=2525
SMTP_RELAY_PUBLIC_TLS_PORT=2465
# smtp-relay: 8060 es solo operativa (salud y metricas). Los puertos SMTP del contenedor (2525 STARTTLS
# obligatorio antes de AUTH, 2465 TLS implicito) se publican en SMTP_RELAY_BIND_ADDRESS (127.0.0.1 por defecto;
# 0.0.0.0 en produccion, con el cortafuegos de docs/Operacion_Despliegue.md).
SMTP_RELAY_PORT=8060
SMTP_RELAY_BIND_ADDRESS=127.0.0.1
# Nombre del relay en el saludo SMTP: el del certificado (acme, ADDITIONAL_SAN).
SMTP_RELAY_HOSTNAME=smtp.localhost
# clamd de la celda por la red mail-scan: todo mensaje con adjuntos se analiza entero. Obligatoria fuera de
# development y test; sin ella, un mensaje con adjuntos recibe 451.
SMTP_RELAY_CLAMD_ADDR=clamd:3310
# Limites: tamano del mensaje (de 64 KiB a 40 MiB, el tope de SES v2), destinatarios por mensaje (de 1 a 50, el
# de transactional), conexiones abiertas por puerto y mensajes que se procesan a la vez (cada uno ocupa en
# memoria unas cuatro veces su tamano: con el perfil autoalojado, 4 x 10 MiB caben en su techo de 256 MiB).
SMTP_RELAY_MAX_MESSAGE_BYTES=10485760
SMTP_RELAY_MAX_RECIPIENTS=50
SMTP_RELAY_MAX_CONNECTIONS=200
SMTP_RELAY_MAX_CONCURRENT_DATA=4
# Cupos por minuto, comunes a las replicas (Redis de la plataforma).
SMTP_RELAY_CONNECTIONS_PER_MIN_PER_IP=60
SMTP_RELAY_MESSAGES_PER_MIN_PER_KEY=300
SMTP_RELAY_MESSAGES_PER_MIN_PER_IP=600
# Freno de fuerza bruta de AUTH: fallos por (usuario, IP) y por IP en la ventana, y duracion del bloqueo.
SMTP_RELAY_AUTH_MAX_FAILURES=10
SMTP_RELAY_AUTH_MAX_FAILURES_PER_IP=30
SMTP_RELAY_AUTH_WINDOW=15m
SMTP_RELAY_AUTH_LOCK=30m
# Espera maxima por linea del cliente y para analizar y entregar un mensaje.
SMTP_RELAY_READ_TIMEOUT=2m
SMTP_RELAY_DELIVER_TIMEOUT=2m

# Ficheros grandes por enlace (mail-files, docs/adr/0014). El webmail sube el fichero, ClamAV lo analiza antes de
# guardarlo (MAIL_FILES_CLAMD_ADDR, obligatoria, por la red mail-scan) y el contenido va al almacen de MINIO_*
# (espacio private/, que el gateway nunca sirve; sin MINIO_ENDPOINT la funcion queda apagada). El correo lleva un
# enlace firmado con MAIL_LINK_SIGNING_KEY que cuelga de PUBLIC_BASE_URL/api/v1/public/files: abrirlo muestra el
# fichero sin gastar descargas y el boton lo entrega como adjunto. MAIL_FILES_DB_PASSWORD, solo en el almacen.
MAIL_FILES_PORT=8061
MAIL_FILES_CLAMD_ADDR=clamd:3310
# Plazo del analisis de un fichero entero (de 10s a 15m).
MAIL_FILES_CLAMD_TIMEOUT=3m
# Directorio de las subidas en espera del veredicto de ClamAV (en el perfil autoalojado, el volumen mail-files-spool).
MAIL_FILES_SPOOL_DIR=/var/spool/mail-files
# Tamano maximo de un fichero, de 1 MiB a 100 MiB: lo que clamd analiza entero y lo que admite el borde.
MAIL_FILES_MAX_FILE_BYTES=104857600
# Caducidad del enlace en dias (por defecto y maxima, hasta 365) y descargas (por defecto y maximo, hasta 10000).
MAIL_FILES_DEFAULT_EXPIRY_DAYS=7
MAIL_FILES_MAX_EXPIRY_DAYS=30
MAIL_FILES_DEFAULT_MAX_DOWNLOADS=20
MAIL_FILES_MAX_DOWNLOADS=100
# Espacio de los enlaces vigentes por buzon y por empresa, y enlaces vigentes por buzon. Se cumple
# fichero maximo <= cuota del buzon <= cuota de la empresa.
MAIL_FILES_MAILBOX_QUOTA_BYTES=2147483648
MAIL_FILES_TENANT_QUOTA_BYTES=21474836480
MAIL_FILES_MAX_ACTIVE_PER_MAILBOX=200
# Subidas a la vez (cada una ocupa hasta el tamano maximo en el directorio temporal) y plazos de subida y de
# descarga (la descarga, de 1m a 6h; el objeto de un enlace caducado o agotado espera este plazo antes de borrarse).
MAIL_FILES_MAX_CONCURRENT_UPLOADS=4
MAIL_FILES_UPLOAD_TIMEOUT=10m
MAIL_FILES_DOWNLOAD_TIMEOUT=30m
# Barrido: cada cuanto (0 lo desactiva; si no, al menos 1m), cuando una subida sin terminar se da por fallida y
# cuanto se conserva en el listado del remitente un enlace cerrado cuyo fichero ya se borro.
MAIL_FILES_SWEEP_INTERVAL=15m
MAIL_FILES_PENDING_GRACE=1h
MAIL_FILES_HISTORY_RETENTION=720h
# Cupos por minuto: la API interna por buzon y el enlace publico por IP (ademas del general del gateway).
MAIL_FILES_RATE_LIMIT_PER_MIN=600
MAIL_FILES_PUBLIC_RATE_LIMIT_PER_MIN=60
