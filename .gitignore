.env
*.env.local
vendor/
bin/
dist/
node_modules/
.DS_Store
*.exe
*.dll
*.so
*.dylib
*.test
*.out
coverage.txt
*.log
tmp/
.idea/
.vscode/
*.swp
*.swo

# Python (scripts de los motores de correo)
__pycache__/
*.pyc
*.pyo
.venv/

# Binario del gateway compilado a mano en su carpeta (artefacto local)
services/gateway/gateway

# Artefactos TypeScript sueltos bajo src/ (la salida real va a dist/)
web/**/src/**/*.js
web/**/src/**/*.js.map

# Certificados y llaves de los motores de correo: nunca en el repositorio
deploy/mail/ssl/
deploy/mail/dkim/
*.pem
*.key
!deploy/mail/ssl-example/*.pem
!deploy/mail/ssl-example/*.key

# Clones de referencia de la fase 0 (solo mientras dura la copia)
/ERP/
/mailcow/

# Ficheros que los entrypoints de los motores generan en los bind mounts (llevan la
# credencial de mail_engine y certificados): nunca en el repositorio
deploy/mail/postfix/conf/sql/
deploy/mail/postfix/conf/sni.map*
deploy/mail/postfix/conf/extra.cf
deploy/mail/postfix/conf/dns_blocklists.cf
deploy/mail/dovecot/conf/sql/
deploy/mail/dovecot/conf/sni.conf
deploy/mail/dovecot/conf/extra.conf
deploy/mail/dovecot/conf/mail_plugins*
deploy/mail/dovecot/conf/acl_anyone
deploy/mail/dovecot/conf/shared_namespace.conf
deploy/mail/dovecot/conf/mail_replica.conf
deploy/mail/dovecot/conf/dovecot-master.*
deploy/mail/rspamd/local.d/external_services.conf
deploy/mail/rspamd/override.d/worker-controller-password.inc
