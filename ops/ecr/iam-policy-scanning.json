{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ConfigurarEscaneoDeImagenes",
      "Effect": "Allow",
      "Action": [
        "ecr:GetRegistryScanningConfiguration",
        "ecr:PutRegistryScanningConfiguration",
        "ecr:DescribeRepositories",
        "ecr:PutImageScanningConfiguration"
      ],
      "Resource": "*"
    },
    {
      "Sid": "LeerHallazgosDeEscaneo",
      "Effect": "Allow",
      "Action": [
        "ecr:DescribeImageScanFindings",
        "ecr:DescribeImages"
      ],
      "Resource": "arn:aws:ecr:us-east-1:188149024609:repository/core-force/*"
    }
  ]
}
