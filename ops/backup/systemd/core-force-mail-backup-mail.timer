[Unit]
Description=Respaldo de los buzones de Core Force Mail cada seis horas

[Timer]
# Media hora despues de cada respaldo de las bases (que empieza a los :15). Si aun estuviera corriendo, el
# cerrojo de BACKUP_DIR hace esperar a este.
OnCalendar=*-*-* 02,08,14,20:45:00 UTC
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
