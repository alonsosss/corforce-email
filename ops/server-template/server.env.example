# Core Force - parametros de aprovisionamiento de servidor.
# Copia este archivo a "server.env" en el servidor y ajusta los valores antes de
# ejecutar bootstrap.sh. bootstrap.sh lo carga automaticamente si existe.
#
#   cp server.env.example server.env
#   sudo ./bootstrap.sh

# Rol del servidor (solo informativo / para hostname y tags): prod | dev | ia | reportes
SERVER_ROLE=prod

# Hostname a fijar en la instancia (vacio = no cambiar).
SERVER_HOSTNAME=core-force-mail-prod

# Usuario de despliegue que usara el pipeline (deploy-fast.sh).
DEPLOY_USER=deploy

# Raiz de la estructura estandar Core Force (app/ env/ docker/ scripts/ ...).
CORE_ROOT=/opt/core-force

# Ruta del codigo desplegado (destino rsync de deploy-fast.sh). Por defecto app/.
DEPLOY_PATH=/opt/core-force-mail/app

# Llave publica SSH autorizada para el usuario de despliegue.
# Si se deja vacio, bootstrap reutiliza la llave del usuario inicial de la AMI
# (p.ej. /home/ubuntu/.ssh/authorized_keys) para no dejar el server inaccesible.
DEPLOY_PUBKEY=

# Tamano del swapfile a crear si el host no tiene swap (0 = no crear).
SWAP_SIZE=4G

# Zona horaria del host (coincide con TZ del docker-compose).
TZ=America/Lima

# Respaldo por empresa (systemd). Solo en el servidor que lleva la base de datos: en un
# host de solo aplicacion duplicaria el volcado sin aportar nada.
INSTALL_BACKUP_TIMERS=yes
