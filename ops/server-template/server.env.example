# Core Force Mail - parametros de aprovisionamiento de servidor.
# Copia este archivo a "server.env" en el servidor y ajusta los valores antes de
# ejecutar bootstrap.sh. bootstrap.sh lo carga automaticamente si existe.
#
#   cp server.env.example server.env
#   sudo ./bootstrap.sh

# Entorno que declaran los servicios: production o staging, nada mas. bootstrap.sh lo
# escribe en el .env de DEPLOY_PATH y no aprovisiona sin el; el despliegue
# (ops/security/secrets/with-secrets.sh) se niega con cualquier otro valor. development y
# test relajan controles y son solo para el entorno local.
ENVIRONMENT=production

# Ambiente de la cuenta de AWS (una por ambiente), para hostname y etiquetas: prod | staging | dev
SERVER_ROLE=prod

# Hostname a fijar en la instancia (vacio = no cambiar).
SERVER_HOSTNAME=core-force-mail-prod

# Usuario de despliegue que usan scripts/deploy-ecr.sh y el despliegue por SSM.
DEPLOY_USER=deploy

# Raiz de la estructura de despliegue (app/ logs/ backups/ ...).
CORE_ROOT=/opt/core-force-mail

# Ruta del codigo desplegado (destino del rsync de scripts/deploy-ecr.sh). Por defecto app/.
DEPLOY_PATH=/opt/core-force-mail/app

# Llave publica SSH autorizada para el usuario de despliegue.
# Si se deja vacio, bootstrap reutiliza la llave del usuario inicial de la AMI
# (p.ej. /home/ubuntu/.ssh/authorized_keys) para no dejar el server inaccesible.
DEPLOY_PUBKEY=

# Tamano del swapfile a crear si el host no tiene swap (0 = no crear).
SWAP_SIZE=4G

# Zona horaria del host (coincide con TZ del docker-compose).
TZ=America/Lima

# Respaldo por empresa (systemd). Solo en el servidor que lleva la base de datos: en un
# host de solo aplicacion duplicaria el volcado sin aportar nada.
INSTALL_BACKUP_TIMERS=yes
