{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "MigracionUnicaDeSecretos",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:CreateSecret",
        "secretsmanager:PutSecretValue",
        "secretsmanager:DescribeSecret",
        "secretsmanager:GetSecretValue"
      ],
      "Resource": "arn:aws:secretsmanager:us-east-1:188149024609:secret:core-force/*"
    }
  ]
}
