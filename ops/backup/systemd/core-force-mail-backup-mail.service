[Unit]
Description=Respaldo de los buzones y las claves de mail_crypt de Core Force Mail
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
# Usuario, ruta y APP_DIR los reescribe ops/backup/install-timers.sh con los del servidor.
User=deploy
WorkingDirectory=/opt/core-force-mail/app
Environment=APP_DIR=/opt/core-force-mail/app
ExecStart=/opt/core-force-mail/app/ops/backup/backup-mail-volumes.sh
UMask=0077
Nice=10
IOSchedulingClass=idle
