{
  "services": {
    "identity":       {"host_env": "IDENTITY_HOST",       "default_host": "identity",       "default_port": "8001"},
    "access-control": {"host_env": "ACCESS_CONTROL_HOST", "default_host": "access-control", "default_port": "8002"},
    "organization":   {"host_env": "ORGANIZATION_HOST",   "default_host": "organization",   "default_port": "8003"},
    "audit":          {"host_env": "AUDIT_HOST",          "default_host": "audit",          "default_port": "8030"},
    "scheduler":      {"host_env": "SCHEDULER_HOST",      "default_host": "scheduler",      "default_port": "8033"},
    "mail-directory": {"host_env": "MAIL_DIRECTORY_HOST", "default_host": "mail-directory", "default_port": "8040"},
    "mail-security":  {"host_env": "MAIL_SECURITY_HOST",  "default_host": "mail-security",  "default_port": "8042"},
    "domain-service": {"host_env": "DOMAIN_SERVICE_HOST", "default_host": "domain-service", "default_port": "8043"},
    "transactional":  {"host_env": "TRANSACTIONAL_HOST",  "default_host": "transactional",  "default_port": "8045"},
    "suppression":    {"host_env": "SUPPRESSION_HOST",    "default_host": "suppression",    "default_port": "8046"},
    "templates":      {"host_env": "TEMPLATES_HOST",      "default_host": "templates",      "default_port": "8047"},
    "web":            {"host_env": "WEB_HOST",            "default_host": "web",            "default_port": "80"}
  },
  "routes": [
    {"prefix": "users",         "service": "identity",       "module": "identity"},
    {"prefix": "sessions",      "service": "identity",       "module": "identity"},
    {"prefix": "roles",         "service": "access-control", "module": "access"},
    {"prefix": "permissions",   "service": "access-control", "module": "access"},
    {"prefix": "user-roles",    "service": "access-control", "module": "access"},
    {"prefix": "check-access",  "service": "access-control", "module": ""},
    {"prefix": "policy",        "service": "access-control", "module": ""},
    {"prefix": "access",        "service": "access-control", "module": ""},
    {"prefix": "organizations", "service": "organization",   "module": "organization"},
    {"prefix": "cells",         "service": "organization",   "module": "organization"},
    {"prefix": "audit",         "service": "audit",          "module": "audit"},
    {"prefix": "scheduler",     "service": "scheduler",      "module": "scheduler"},
    {"prefix": "mail-domains",  "service": "mail-directory", "module": "domains"},
    {"prefix": "mailboxes",     "service": "mail-directory", "module": "mailboxes"},
    {"prefix": "mail-routing",  "service": "mail-directory", "module": "mail_routing"},
    {"prefix": "mail-security", "service": "mail-security",  "module": "mail_security"},
    {"prefix": "domains",       "service": "domain-service", "module": "domains"},
    {"prefix": "transactional", "service": "transactional",  "module": "transactional"},
    {"prefix": "suppression",   "service": "suppression",    "module": "suppression"},
    {"prefix": "templates",     "service": "templates",      "module": "templates"}
  ],
  "public": [
    {"method": "POST", "path": "/public/transactional/ses-events/{tenantID}", "service": "transactional"},
    {"method": "GET",  "path": "/public/transactional/unsubscribe",           "service": "transactional"},
    {"method": "POST", "path": "/public/transactional/unsubscribe",           "service": "transactional"}
  ],
  "frontend": "web"
}
