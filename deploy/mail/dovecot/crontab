# Tareas periodicas de Dovecot (antes las lanzaba ofelia desde fuera del contenedor).
# Las ejecuta busybox crond bajo supervisord; cada linea carga el entorno del contenedor
# desde /source_env.sh. Solo el nodo MASTER=y ejecuta las tareas que escriben.
# maildir_gc.sh y maildir_reconcile.sh comparten el cerrojo _garbage/.reconcile.lock: la purga
# de _garbage y el traslado de maildir a _garbage nunca corren a la vez.
0 * * * *    /bin/bash -c 'source /source_env.sh; [[ ${MASTER} == y ]] && /usr/local/bin/gosu vmail /usr/local/bin/trim_logs.sh || exit 0'
0 0 * * *    /bin/bash -c 'source /source_env.sh; [[ ${MASTER} == y ]] && /usr/local/bin/gosu vmail /usr/local/bin/clean_q_aged.sh || exit 0'
*/30 * * * * /bin/bash -c 'source /source_env.sh; /usr/local/bin/gosu vmail flock /var/vmail/_garbage/.reconcile.lock /usr/local/bin/maildir_gc.sh'
*/5 * * * *  /bin/bash -c 'source /source_env.sh; [[ ${MASTER} == y ]] && /usr/local/bin/gosu vmail /usr/local/bin/maildir_reconcile.sh || exit 0'
0 3 * * *    /bin/bash -c 'source /source_env.sh; /usr/local/bin/sa-rules.sh'
0 0 * * *    /bin/bash -c 'source /source_env.sh; /usr/local/bin/gosu vmail /usr/local/bin/optimize-fts.sh'
*/5 * * * *  /bin/bash -c 'source /source_env.sh; /usr/local/bin/gosu vmail /usr/local/bin/repl_health.sh'
